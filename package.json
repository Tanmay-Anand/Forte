{
  "name": "forte",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:apk": "eas build -p android --profile sideload",
