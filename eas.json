{
  "cli": { "version": ">= 5.9.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "sideload": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "production"
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "channel": "production"
    }
  }
}
