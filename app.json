{
  "expo": {
    "name": "Forte",
    "slug": "forte",
    "version": "1.3.0",
    "orientation": "default",
    "scheme": "forte",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.forte.tracker",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#E9F5F8"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFB",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#111213"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "position": "absolute",
          "backgroundColor": "#111213"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "usesCleartextTraffic": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "./plugins/with-android-abis",
        {
          "abis": [
            "arm64-v8a"
          ]
        }
      ],
      "./plugins/with-notification-icon"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "15c6e021-ad7a-4402-af5d-6bb0e5d50362"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/15c6e021-ad7a-4402-af5d-6bb0e5d50362"
    },
    "ios": {}
  }
}
